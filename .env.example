# --- Core ---------------------------------------------------------------
# Empty DATABASE_URL falls back to sqlite:///backend/swarmbuild.db
DATABASE_URL=
REDIS_URL=
STORAGE_PATH=/data/projects

# WARNING: set this ONCE before the first run and never change it afterwards.
# Provider API keys in the DB are encrypted with it; changing (or adding) it
# later makes every stored key undecryptable. If unset, the app generates and
# keeps a secret in backend/.secret — existing installs must leave it that way.
ENCRYPTION_SECRET=

ADMIN_EMAIL=founder@swarmbuild.ai
ADMIN_PASSWORD=replace-with-a-long-unique-founder-password

# --- Model provider API keys ---------------------------------------------
# Only the initial seed: keys are imported into the DB key pool on first start
# and then managed from the admin panel (a provider can hold many keys).
# Fill in at least one; the runner rotates across whatever is usable.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
QWEN_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Optional endpoint overrides (defaults point at the official APIs)
OPENAI_BASE_URL=
ANTHROPIC_BASE_URL=

# mock = offline dev swarm; real calls also require ENABLE_REAL_MODEL_CALLS
DEFAULT_MODEL_PROVIDER=mock
ENABLE_REAL_MODEL_CALLS=false

# --- Runtime limits --------------------------------------------------------
MAX_PROJECT_RUNTIME_MINUTES=120
MAX_PHASE_RUNTIME_MINUTES=30
MAX_COMMAND_RUNTIME_SECONDS=120

# --- API / frontend ---------------------------------------------------------
# Comma-separated production origins for CORS; empty = localhost-only dev mode
CORS_ALLOW_ORIGINS=
# Expose /docs, /redoc, /openapi.json (off by default)
ENABLE_API_DOCS=false
# Log level for the swarmbuild.* loggers (AI call diagnostics)
SWARMBUILD_LOG_LEVEL=INFO
# Frontend: where the browser reaches the API (frontend/.env.local)
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# --- Billing ----------------------------------------------------------------
PLATFORM_FEE_PERCENT=30
TELEGRAM_PAYMENT_BOT_URL=
